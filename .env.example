# グラフ送信先 (cgi/sensors.py をホストしているサーバー) の IP アドレス
GRAPH_SERVER_IP=192.168.1.100

# 必要に応じて変更するオプション設定
# GRAPH_SERVER_SCHEME=http
# GRAPH_SERVER_PORT=80
# GRAPH_SERVER_PATH=/cgi-bin/sensors.py
# GRAPH_SEND_INTERVAL=2.0
# GRAPH_SEND_TIMEOUT=5.0

# URL を直接指定したい場合はこちらを使用（指定時は GRAPH_SERVER_* より優先）
# SENSOR_CGI_URL=http://192.168.1.100/cgi-bin/sensors.py
